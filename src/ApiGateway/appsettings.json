{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "THIS_IS_A_SUPER_SECRET_KEY_FOR_DEVELOPMENT"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/auth/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/auth" }
        ]
      },
      "product-route": {
        "ClusterId": "product-cluster",
        "Match": {
          "Path": "/products/{**catch-all}"
        },
        "AuthorizationPolicy": "Authenticated",
        "Transforms": [
          { "PathRemovePrefix": "/products" }
        ]
      }
    },

    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-destination": {
            "Address": "http://localhost:5134/"
          }
        }
      },
      "product-cluster": {
        "Destinations": {
          "product-destination": {
            "Address": "http://localhost:5192/"
          }
        }
      }
    }
  },
  "OpenTelemetry": {
    "ServiceName": "ApiGateway",
    "ServiceVersion": "1.0.0",
    "Endpoint": "http://otel-collector:4317"
  },
  "Seq": {
    "ServerUrl": "http://localhost:5341"
  }
}
